    {
      "dot": "amber",
      "title": "Forward path",
      "items": [
        "External Authority → Shadow Native: reconcile and compare",
        "Shadow Native → Drain: certify selected boundary",
        "Drain → Native Authority: fence old writer and change epoch",
        "Drain can still abort before the authority switch"
      ]
